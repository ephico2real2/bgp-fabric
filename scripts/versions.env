# scripts/versions.env — the two images this lab pins.
#
# FRR is the router. The agent image is built FROM it and adds nothing to
# FRR itself, so this pin is what "which FRR" means for the whole fabric.
# netshoot is only used to look at the wire from inside the VM's network
# namespaces; nothing depends on its contents but tcpdump and ip.
FRR_IMAGE=quay.io/frrouting/frr:10.7.1
NETSHOOT_IMAGE=nicolaka/netshoot:v0.16
